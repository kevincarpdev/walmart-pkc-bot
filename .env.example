# List of Walmart product URLs (comma separated)
PRODUCT_URLS=https://www.walmart.com/ip/example-product-1,https://www.walmart.com/ip/example-product-2

# SOCKS5 or HTTP proxies (comma separated)
# Format: protocol://user:pass@host:port or protocol://host:port
PROXIES=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# Time to start aggressive refreshing (HH:MM:SS)
DROP_TIME=05:59:00

# Checkout Details
GUEST_EMAIL=your-email@example.com
FIRST_NAME=First
LAST_NAME=Last
STREET_ADDRESS=123 Main St
CITY=Anytown
STATE=CA
ZIP_CODE=12345
